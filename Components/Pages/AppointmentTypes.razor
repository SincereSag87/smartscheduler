@page "/appointment-types"
@attribute [Authorize(Roles = AppRoles.AdminOnly)]
@rendermode InteractiveServer
@inject IAdminConfigurationService AdminService

<section class="page-title">
    <div>
        <h1>Appointment Types</h1>
        <p>Manage booking types, default durations, colors, and active scheduling status.</p>
    </div>
    <button class="btn btn-primary" @onclick="StartNew">New Type</button>
</section>

<section class="ss-grid panel-grid">
    <div class="ss-card">
        <h2 class="h4 mb-3">Type Catalog</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Duration</th>
                        <th>Color</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var type in appointmentTypes)
                    {
                        <tr>
                            <td><strong>@type.Name</strong></td>
                            <td>@type.DurationMinutes min</td>
                            <td><span class="color-swatch" style="background:@type.Color"></span>@type.Color</td>
                            <td><span class="pill @(type.IsActive ? "pill-confirmed" : "pill-cancelled")">@(type.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-end">
                                <button class="btn btn-outline-primary btn-sm me-2" @onclick="() => EditType(type.Id)">Edit</button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => ToggleType(type.Id)">Toggle</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <aside class="ss-card">
        <h2 class="h4 mb-3">@FormTitle</h2>
        <div class="mb-3">
            <label class="form-label" for="name">Name</label>
            <input id="name" class="form-control" @bind="editor.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="duration">Duration minutes</label>
            <input id="duration" type="number" min="15" step="15" class="form-control" @bind="editor.DurationMinutes" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="color">Color</label>
            <input id="color" type="color" class="form-control form-control-color" @bind="editor.Color" />
        </div>
        <div class="form-check form-switch">
            <input id="active" class="form-check-input" type="checkbox" @bind="editor.IsActive" />
            <label class="form-check-label" for="active">Active for booking</label>
        </div>
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-primary" @onclick="SaveType">Save</button>
            <button class="btn btn-outline-secondary" @onclick="StartNew">Reset</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="alert @messageClass mt-3 mb-0">@message</div>
        }
    </aside>
</section>

@code {
    private List<AppointmentType> appointmentTypes = [];
    private AppointmentType editor = new();
    private string message = string.Empty;
    private string messageClass = "alert-info";
    private string FormTitle => editor.Id == 0 ? "Add Type" : "Edit Type";

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        appointmentTypes = (await AdminService.GetAppointmentTypesAsync()).ToList();
    }

    private async Task StartNew()
    {
        editor = await AdminService.GetAppointmentTypeEditorAsync();
        message = string.Empty;
    }

    private async Task EditType(int id)
    {
        editor = await AdminService.GetAppointmentTypeEditorAsync(id);
        message = string.Empty;
    }

    private async Task SaveType()
    {
        if (string.IsNullOrWhiteSpace(editor.Name) || editor.DurationMinutes < 15)
        {
            SetMessage("Name and a duration of at least 15 minutes are required.", "alert-warning");
            return;
        }

        await AdminService.SaveAppointmentTypeAsync(editor);
        await LoadData();
        await StartNew();
        SetMessage("Appointment type saved.", "alert-success");
    }

    private async Task ToggleType(int id)
    {
        await AdminService.ToggleAppointmentTypeAsync(id);
        await LoadData();
        SetMessage("Appointment type status updated.", "alert-success");
    }

    private void SetMessage(string text, string cssClass)
    {
        message = text;
        messageClass = cssClass;
    }
}
