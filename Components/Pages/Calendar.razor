@page "/calendar"
@attribute [Authorize(Roles = AppRoles.SchedulerOrManagerOrAdmin)]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IScheduleRepository ScheduleRepository
@inject IAvailabilityService AvailabilityService
@inject NavigationManager NavigationManager

<section class="page-title">
    <div>
        <h1>Calendar</h1>
        <p>Day, week, and month planning with status-colored appointments from SQL Server.</p>
        @if (!string.IsNullOrWhiteSpace(refreshMessage))
        {
            <div class="live-refresh">@refreshMessage</div>
        }
    </div>
    <div class="btn-group">
        <button class="btn btn-outline-primary active">Week</button>
        <button class="btn btn-outline-primary">Day</button>
        <button class="btn btn-outline-primary">Month</button>
    </div>
</section>

<section class="ss-card">
    <div class="calendar-toolbar">
        <div>
            <h2 class="h4 mb-0">@weekStart.ToString("MMMM yyyy")</h2>
            <div class="muted">Appointments and availability are loaded from Entity Framework Core.</div>
        </div>
        <a class="btn btn-primary btn-sm" href="appointments">Book Slot</a>
    </div>

    @if (events.Count == 0)
    {
        <div class="alert alert-info mb-0">No appointments are scheduled for this week.</div>
    }
    else
    {
        <div class="calendar-grid">
            @for (var offset = 0; offset < 7; offset++)
            {
                var day = weekStart.AddDays(offset);
                <div class="calendar-day">
                    <strong>@day.ToString("ddd")</strong>
                    <div class="muted">@day.ToString("MMM d")</div>

                    @foreach (var item in events.Where(e => e.StartsAt.Date == day.Date))
                    {
                        <div class="calendar-event" draggable="true" style="background:@item.Color">
                            <strong>@item.StartsAt.ToString("h:mm tt")</strong>
                            <div>@item.Subject</div>
                            <small>@item.Employee</small>
                        </div>
                    }

                    @foreach (var block in availabilityBlocks.Where(e => e.StartsAt.Date == day.Date))
                    {
                        <div class="availability-overlay @AvailabilityCss(block.Status)">
                            <strong>@block.Status</strong>
                            <div>@block.StartsAt.ToString("h:mm tt") - @block.EndsAt.ToString("h:mm tt")</div>
                            <small>@block.Employee</small>
                        </div>
                    }
                </div>
            }
        </div>
    }
</section>

@code {
    private readonly DateTime weekStart = DateTime.Today;
    private List<CalendarEvent> events = [];
    private List<AvailabilityListItem> availabilityBlocks = [];
    private HubConnection? hubConnection;
    private string refreshMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCalendar();
        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/schedule-hub"))
            .WithAutomaticReconnect()
            .Build();
        hubConnection.On<string>("ScheduleChanged", async message =>
        {
            refreshMessage = $"Updated just now: {message}";
            await LoadCalendar();
            await InvokeAsync(StateHasChanged);
        });
        await hubConnection.StartAsync();
    }

    private async Task LoadCalendar()
    {
        events = (await ScheduleRepository.GetCalendarEventsAsync(weekStart, weekStart.AddDays(7))).ToList();
        availabilityBlocks = (await AvailabilityService.GetAvailabilityAsync(weekStart, weekStart.AddDays(7))).ToList();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private static string AvailabilityCss(AvailabilityStatus status) =>
        status switch
        {
            AvailabilityStatus.Available => "available",
            AvailabilityStatus.Busy => "busy",
            _ => "timeoff"
        };
}
