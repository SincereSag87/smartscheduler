@page "/admin"
@inject IScheduleRepository ScheduleRepository
@inject IAdminConfigurationService AdminService

<section class="page-title">
    <div>
        <h1>Administration</h1>
        <p>Manage users, roles, departments, business hours, locations, and audit controls.</p>
    </div>
    <a class="btn btn-primary" href="Account/Register">Invite User</a>
</section>

<section class="ss-grid kpi-grid">
    <div class="ss-card">
        <h2 class="h4">Users & Roles</h2>
        <p class="muted">ASP.NET Core Identity with role-based access control for admins, schedulers, managers, and employees.</p>
        <span class="pill pill-scheduled">Identity enabled</span>
    </div>
    <div class="ss-card">
        <h2 class="h4">Appointment Types</h2>
        <p class="muted">@summary.ActiveAppointmentTypes of @summary.AppointmentTypes types are active for booking.</p>
        <a class="btn btn-outline-primary btn-sm" href="appointment-types">Manage Types</a>
    </div>
    <div class="ss-card">
        <h2 class="h4">Locations</h2>
        <p class="muted">@summary.ActiveLocations of @summary.Locations locations are available for scheduling.</p>
        <a class="btn btn-outline-primary btn-sm" href="locations">Manage Locations</a>
    </div>
    <div class="ss-card">
        <h2 class="h4">Business Hours</h2>
        <p class="muted">@summary.BusinessHourRules weekly rules and @summary.ClosureBlocks closure blocks configured.</p>
        <a class="btn btn-outline-primary btn-sm" href="business-hours">Manage Hours</a>
    </div>
    <div class="ss-card">
        <h2 class="h4">Audit Logs</h2>
        <p class="muted">Last update: @(summary.LastUpdated?.ToLocalTime().ToString("MMM d, h:mm tt") ?? "No records")</p>
        <span class="pill pill-completed">@auditLogs.Count records</span>
    </div>
</section>

<section class="ss-card mt-4">
    <div class="calendar-toolbar">
        <div>
            <h2 class="h4 mb-1">Audit Log</h2>
            <div class="muted">Recent create, edit, cancel, complete, reschedule, and availability actions.</div>
        </div>
    </div>
    @if (auditLogs.Count == 0)
    {
        <div class="alert alert-info mb-0">No audit records have been written yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Entity</th>
                        <th>Action</th>
                        <th>Actor</th>
                        <th>When</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in auditLogs)
                    {
                        <tr>
                            <td><strong>@log.EntityName</strong></td>
                            <td>@log.Action</td>
                            <td>@log.Actor</td>
                            <td>@log.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private List<AuditLogItem> auditLogs = [];
    private AdminConfigurationSummary summary = new(0, 0, 0, 0, 0, 0, null);

    protected override async Task OnInitializedAsync()
    {
        summary = await AdminService.GetSummaryAsync();
        auditLogs = (await ScheduleRepository.GetAuditLogsAsync()).ToList();
    }
}
