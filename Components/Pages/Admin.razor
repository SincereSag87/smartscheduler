@page "/admin"

<section class="page-title">
    <div>
        <h1>Administration</h1>
        <p>Manage users, roles, departments, business hours, locations, and audit controls.</p>
    </div>
    <a class="btn btn-primary" href="Account/Register">Invite User</a>
</section>

<section class="ss-grid kpi-grid">
    <div class="ss-card">
        <h2 class="h4">Users & Roles</h2>
        <p class="muted">ASP.NET Core Identity with role-based access control for admins, schedulers, managers, and employees.</p>
        <span class="pill pill-scheduled">Identity enabled</span>
    </div>
    <div class="ss-card">
        <h2 class="h4">Departments</h2>
        <p class="muted">Client Success, Operations, and Implementation seeded in the EF Core model.</p>
        <span class="pill pill-confirmed">Seed data</span>
    </div>
    <div class="ss-card">
        <h2 class="h4">Business Hours</h2>
        <p class="muted">Location-aware working windows and time-off blocks for availability management.</p>
        <span class="pill pill-pending">Configurable</span>
    </div>
    <div class="ss-card">
        <h2 class="h4">Audit Logs</h2>
        <p class="muted">Database entity ready to track appointment lifecycle changes and administrative actions.</p>
        <span class="pill pill-completed">Compliance ready</span>
    </div>
</section>
