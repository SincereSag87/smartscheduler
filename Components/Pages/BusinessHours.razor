@page "/business-hours"
@attribute [Authorize(Roles = AppRoles.AdminOnly)]
@rendermode InteractiveServer
@inject IAdminConfigurationService AdminService

<section class="page-title">
    <div>
        <h1>Business Hours</h1>
        <p>Configure default organization hours, per-location rules, and holiday or closure blocks.</p>
    </div>
    <button class="btn btn-primary" @onclick="StartNewClosure">New Closure</button>
</section>

<section class="ss-grid panel-grid">
    <div class="ss-card">
        <h2 class="h4 mb-3">Default Weekly Hours</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Day</th>
                        <th>Open</th>
                        <th>Close</th>
                        <th>Closed</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hour in businessHours)
                    {
                        <tr>
                            <td><strong>@hour.DayOfWeek</strong></td>
                            <td><input type="time" class="form-control" value="@hour.OpensAt.ToString("HH:mm")" @onchange="args => UpdateOpen(hour, args)" /></td>
                            <td><input type="time" class="form-control" value="@hour.ClosesAt.ToString("HH:mm")" @onchange="args => UpdateClose(hour, args)" /></td>
                            <td><input type="checkbox" class="form-check-input" @bind="hour.IsClosed" /></td>
                            <td class="text-end"><button class="btn btn-outline-primary btn-sm" @onclick="() => SaveHour(hour)">Save</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <aside class="ss-card">
        <h2 class="h4 mb-3">@ClosureFormTitle</h2>
        <div class="mb-3">
            <label class="form-label" for="scope">Scope</label>
            <select id="scope" class="form-select" @bind="closureEditor.Scope">
                @foreach (var scope in Enum.GetValues<ClosureScope>())
                {
                    <option value="@scope">@scope</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label" for="location">Location</label>
            <select id="location" class="form-select" @bind="closureEditor.LocationId" disabled="@(closureEditor.Scope == ClosureScope.Organization)">
                <option value="">Organization-wide</option>
                @foreach (var location in locations)
                {
                    <option value="@location.Id">@location.Name</option>
                }
            </select>
        </div>
        <div class="form-card">
            <div>
                <label class="form-label" for="start-date">Start date</label>
                <input id="start-date" type="date" class="form-control" @bind="closureDate" />
            </div>
            <div>
                <label class="form-label" for="start-time">Start</label>
                <input id="start-time" type="time" class="form-control" value="@closureStart" @onchange="args => closureStart = args.Value?.ToString() ?? closureStart" />
            </div>
            <div>
                <label class="form-label" for="end-time">End</label>
                <input id="end-time" type="time" class="form-control" value="@closureEnd" @onchange="args => closureEnd = args.Value?.ToString() ?? closureEnd" />
            </div>
        </div>
        <div class="mt-3">
            <label class="form-label" for="reason">Reason</label>
            <input id="reason" class="form-control" @bind="closureEditor.Reason" />
        </div>
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-primary" @onclick="SaveClosure">Save</button>
            <button class="btn btn-outline-secondary" @onclick="StartNewClosure">Reset</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="alert @messageClass mt-3 mb-0">@message</div>
        }
    </aside>
</section>

<section class="ss-card mt-4">
    <h2 class="h4 mb-3">Holiday & Closure Blocks</h2>
    @if (closures.Count == 0)
    {
        <div class="alert alert-info mb-0">No closure blocks configured.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Scope</th>
                        <th>Location</th>
                        <th>Window</th>
                        <th>Reason</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var closure in closures)
                    {
                        <tr>
                            <td><span class="pill pill-pending">@closure.Scope</span></td>
                            <td>@closure.Location</td>
                            <td>@closure.StartsAt.ToString("MMM d, h:mm tt") - @closure.EndsAt.ToString("h:mm tt")</td>
                            <td>@closure.Reason</td>
                            <td class="text-end">
                                <button class="btn btn-outline-primary btn-sm me-2" @onclick="() => EditClosure(closure.Id)">Edit</button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteClosure(closure.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private List<BusinessHour> businessHours = [];
    private List<Location> locations = [];
    private List<ClosureBlockItem> closures = [];
    private ClosureBlock closureEditor = new();
    private DateTime closureDate = DateTime.Today.AddDays(7);
    private string closureStart = "08:00";
    private string closureEnd = "17:00";
    private string message = string.Empty;
    private string messageClass = "alert-info";
    private string ClosureFormTitle => closureEditor.Id == 0 ? "Add Closure" : "Edit Closure";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await StartNewClosure();
    }

    private async Task LoadData()
    {
        businessHours = (await AdminService.GetBusinessHoursAsync()).ToList();
        locations = (await AdminService.GetLocationsAsync()).Where(location => location.IsActive).ToList();
        closures = (await AdminService.GetClosureBlocksAsync()).ToList();
    }

    private async Task SaveHour(BusinessHour hour)
    {
        await AdminService.SaveBusinessHourAsync(hour);
        await LoadData();
        SetMessage("Business hours saved.", "alert-success");
    }

    private async Task StartNewClosure()
    {
        closureEditor = await AdminService.GetClosureBlockEditorAsync();
        ApplyClosureToForm();
        message = string.Empty;
    }

    private async Task EditClosure(int id)
    {
        closureEditor = await AdminService.GetClosureBlockEditorAsync(id);
        ApplyClosureToForm();
        message = string.Empty;
    }

    private async Task SaveClosure()
    {
        if (!TimeOnly.TryParse(closureStart, out var start) || !TimeOnly.TryParse(closureEnd, out var end) || start >= end)
        {
            SetMessage("Closure start and end times must be valid.", "alert-warning");
            return;
        }

        if (string.IsNullOrWhiteSpace(closureEditor.Reason))
        {
            SetMessage("Closure reason is required.", "alert-warning");
            return;
        }

        closureEditor.StartsAt = closureDate.Date.Add(start.ToTimeSpan());
        closureEditor.EndsAt = closureDate.Date.Add(end.ToTimeSpan());
        await AdminService.SaveClosureBlockAsync(closureEditor);
        await LoadData();
        await StartNewClosure();
        SetMessage("Closure saved.", "alert-success");
    }

    private async Task DeleteClosure(int id)
    {
        await AdminService.DeleteClosureBlockAsync(id);
        await LoadData();
        SetMessage("Closure deleted.", "alert-success");
    }

    private void ApplyClosureToForm()
    {
        closureDate = closureEditor.StartsAt.Date;
        closureStart = closureEditor.StartsAt.ToString("HH:mm");
        closureEnd = closureEditor.EndsAt.ToString("HH:mm");
    }

    private static void UpdateOpen(BusinessHour hour, ChangeEventArgs args)
    {
        if (TimeOnly.TryParse(args.Value?.ToString(), out var value))
        {
            hour.OpensAt = value;
        }
    }

    private static void UpdateClose(BusinessHour hour, ChangeEventArgs args)
    {
        if (TimeOnly.TryParse(args.Value?.ToString(), out var value))
        {
            hour.ClosesAt = value;
        }
    }

    private void SetMessage(string text, string cssClass)
    {
        message = text;
        messageClass = cssClass;
    }
}
