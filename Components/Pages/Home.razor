@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IScheduleRepository ScheduleRepository
@inject NavigationManager NavigationManager

<section class="page-title">
    <div>
        <h1>Dashboard</h1>
        <p>Today&apos;s schedule, utilization, team availability, and live appointment alerts.</p>
        @if (!string.IsNullOrWhiteSpace(refreshMessage))
        {
            <div class="live-refresh">@refreshMessage</div>
        }
    </div>
    <a class="btn btn-primary" href="appointments">New Appointment</a>
</section>

@if (dashboard is null)
{
    <div class="ss-card">Loading dashboard...</div>
}
else
{
    <section class="ss-grid kpi-grid">
        <div class="ss-card kpi">
            <div class="kpi-label">Portfolio version</div>
            <div class="kpi-value">1.0</div>
            <span class="pill pill-completed">Core modules complete</span>
        </div>
        <div class="ss-card kpi">
            <div class="kpi-label">Today&apos;s appointments</div>
            <div class="kpi-value">@dashboard.TodayAppointments</div>
            <span class="pill pill-confirmed">Confirmed flow</span>
        </div>
        <div class="ss-card kpi">
            <div class="kpi-label">Weekly utilization</div>
            <div class="kpi-value">@dashboard.WeeklyUtilization%</div>
            <span class="pill pill-scheduled">Team capacity</span>
        </div>
        <div class="ss-card kpi">
            <div class="kpi-label">Pending requests</div>
            <div class="kpi-value">@dashboard.PendingRequests</div>
            <span class="pill pill-pending">Needs action</span>
        </div>
        <div class="ss-card kpi">
            <div class="kpi-label">Team available</div>
            <div class="kpi-value">@dashboard.TeamAvailable</div>
            <span class="pill pill-available">Bookable now</span>
        </div>
    </section>

    <section class="ss-grid panel-grid mt-4">
        <div class="ss-card">
            <div class="calendar-toolbar">
                <div>
                    <h2 class="h4 mb-1">Upcoming Meetings</h2>
                    <div class="muted">Live operational queue for schedulers and managers.</div>
                </div>
                <a class="btn btn-outline-primary btn-sm" href="calendar">Open Calendar</a>
            </div>

            <div class="event-list">
                @foreach (var item in dashboard.UpcomingMeetings)
                {
                    <div class="event-row">
                        <div class="event-main">
                            <span class="event-bar" style="background:@item.Color"></span>
                            <div>
                                <strong>@item.Subject</strong>
                                <div class="muted">@item.Customer with @item.Employee</div>
                            </div>
                        </div>
                        <div class="text-end">
                            <div>@item.StartsAt.ToString("h:mm tt")</div>
                            <span class="pill @StatusClass(item.Status)">@item.Status</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <aside class="ss-card">
            <h2 class="h4 mb-3">Notifications</h2>
            <div class="notification-list">
                @foreach (var notification in dashboard.Notifications)
                {
                    <div class="notification-row d-block">
                        <div class="d-flex justify-content-between gap-2">
                            <strong>@notification.Title</strong>
                            <button class="btn btn-link btn-sm p-0" @onclick="() => MarkNotificationRead(notification.Id)">Mark read</button>
                        </div>
                        <p class="muted mb-1">@notification.Message</p>
                        <small class="muted">@notification.Age</small>
                    </div>
                }
            </div>
        </aside>
    </section>

    <section class="ss-card mt-4">
        <div class="calendar-toolbar">
            <div>
                <h2 class="h4 mb-1">Completed Modules</h2>
                <div class="muted">Portfolio-ready scope across scheduling, reporting, administration, and security.</div>
            </div>
            <a class="btn btn-outline-primary btn-sm" href="project-info">Project Info</a>
        </div>
        <div class="ss-grid kpi-grid">
            @foreach (var module in completedModules)
            {
                <span class="pill pill-confirmed">@module</span>
            }
        </div>
    </section>
}

@code {
    private DashboardSnapshot? dashboard;
    private HubConnection? hubConnection;
    private string refreshMessage = string.Empty;
    private readonly List<string> completedModules =
    [
        "Identity/RBAC",
        "Appointments",
        "Availability",
        "SignalR",
        "Reports",
        "Audit Logs",
        "Admin Config"
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/schedule-hub"))
            .WithAutomaticReconnect()
            .Build();
        hubConnection.On<string>("ScheduleChanged", async message =>
        {
            refreshMessage = $"Updated just now: {message}";
            await LoadDashboard();
            await InvokeAsync(StateHasChanged);
        });
        await hubConnection.StartAsync();
    }

    private async Task LoadDashboard()
    {
        dashboard = await ScheduleRepository.GetDashboardAsync();
    }

    private async Task MarkNotificationRead(int id)
    {
        await ScheduleRepository.MarkNotificationReadAsync(id);
        await LoadDashboard();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private static string StatusClass(AppointmentStatus status) => $"pill-{status.ToString().ToLowerInvariant()}";
}
